# Security + caching headers (Netlify and Cloudflare Pages both read this file).
# The .htaccess beside it carries the equivalent rules for Apache/shared hosting.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'none'; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=86400

/images/opt/*
  Cache-Control: public, max-age=2592000

/images/*.png
  Cache-Control: public, max-age=2592000

/icons/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=604800
